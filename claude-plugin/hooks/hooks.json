{
  "description": "tmux-delta activity pills (agent-tmux-status.sh) and apex-mode ping delivery (apex-manager-notify.sh). See README.md, \"Coding-agent hooks\", for what each verb does and why the argument to apex-manager-notify.sh is required.",
  "hooks": {
    "PreToolUse": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/../scripts/agent-tmux-status.sh set" }] }
    ],
    "Notification": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/../scripts/agent-tmux-status.sh notify" }] }
    ],
    "Stop": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/../scripts/agent-tmux-status.sh clear" }] },
      { "matcher": "", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/../scripts/apex-manager-notify.sh stop", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/../scripts/apex-manager-notify.sh prompt", "timeout": 10 }] }
    ],
    "SessionStart": [
      { "matcher": "startup|resume", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/../scripts/apex-manager-notify.sh session-start", "timeout": 10 }] }
    ],
    "PostToolBatch": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/../scripts/apex-manager-notify.sh post-tools", "timeout": 10 }] }
    ]
  }
}
